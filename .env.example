# --- Database (MySQL) ---
# Local Docker (docker-compose) example:
DATABASE_URL="mysql://salt:salt@db:3306/saltintake"
# Azure Database for MySQL Flexible Server example (TLS required):
# DATABASE_URL="mysql://USER:PASSWORD@your-server.mysql.database.azure.com:3306/saltintake?sslaccept=strict"

# --- NextAuth (Auth.js v5) ---
# Run: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app (e.g. http://localhost:3000 in dev)
AUTH_URL="http://localhost:3000"
# Trust proxy when behind Azure App Service / reverse proxy
AUTH_TRUST_HOST="true"

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Azure OpenAI (OCR via vision-capable chat completion) ---
AZURE_OPENAI_ENDPOINT="https://YOUR-RESOURCE.openai.azure.com"
AZURE_OPENAI_API_KEY=""
# The Azure deployment name you created (e.g. "gpt-5.2", "gpt-4o", etc.)
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-10-21"

# --- App ---
# Daily salt target in grams (WHO recommends < 5g)
NEXT_PUBLIC_DAILY_SALT_TARGET_G="6"
